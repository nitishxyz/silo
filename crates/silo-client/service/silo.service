# systemd user unit for the silo server, written by `silo up`.
[Unit]
Description=silo terminal server

[Service]
# The server sends READY=1 once serving; a takeover successor sends
# MAINPID=<its pid> before committing, so systemd follows it.
Type=notify
NotifyAccess=all
# Foreground, no idle exit; takes over a server already running outside
# the unit.
ExecStart=@EXE@ server --adopt
# Hot upgrade: the successor runs inside this unit (its cgroup and
# NOTIFY_SOCKET), takes every session live and becomes the main process.
ExecReload=@EXE@ server --takeover --daemon --idle-exit 0
Restart=on-failure
# `--adopt` exits 0 when the running server cannot be taken over live;
# before READY=1 that is a failure, but retrying cannot help.
RestartPreventExitStatus=0
UMask=0077
# Pinned so the unit and CLI clients agree even if the service manager's
# environment differs.
Environment=@SILO_HOME@
# Stop signals only the server: its own shutdown hangs up every shell. After
# a takeover the old server exits by itself and the shells it handed over
# must survive it, so the cgroup is not swept.
KillMode=process
# No PrivateTmp/ProtectHome: shells need the user's real home and /tmp.

[Install]
WantedBy=default.target
